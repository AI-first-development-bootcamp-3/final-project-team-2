# API settings for running on the host (`pnpm dev`). Copy to .env.
# Inside docker compose these are injected by docker-compose.yml instead.

PORT=3000

# Points at the compose Postgres exposed on localhost
DATABASE_URL=postgresql://abra:abra_dev_password@localhost:5432/timesheet

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT signing keys — required, no default; generate with: openssl rand -base64 48
# Real values live in .env / deployment secrets only, never in git.
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-string
