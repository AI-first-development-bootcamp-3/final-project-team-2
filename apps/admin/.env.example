# Admin console settings. Copy to .env — defaults work out of the box.

# Includes the /api/v1 prefix — fetch(`${import.meta.env.VITE_API_URL}/health`)
# On Vercel this points at the admin deployment's own origin (e.g.
# https://timesheet-admin.vercel.app/api/v1): api/[...path].ts proxies /api/*
# to the API project so the refresh cookie stays first-party.
VITE_API_URL=http://localhost:3000/api/v1

# Vercel-only (unused in local dev): upstream API deployment the /api/* proxy
# forwards to, e.g. https://timesheet-api-seven.vercel.app
# API_ORIGIN=
