# Compose-level settings. Copy to .env — defaults work out of the box.
# Used by docker-compose.yml for the Postgres container and host port mappings.

POSTGRES_USER=abra
POSTGRES_PASSWORD=abra_dev_password
POSTGRES_DB=timesheet

# Host-side port mappings — override if a port is taken on your machine
POSTGRES_PORT=5432
API_PORT=3000
MOBILE_PORT=5173
ADMIN_PORT=5174

# API JWT signing key (local/CI placeholder — override in real deployments)
JWT_SECRET=local-dev-jwt-signing-key
